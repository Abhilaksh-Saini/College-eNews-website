# Groq API key (free tier) from https://console.groq.com/keys. Optional: without it the site
# still runs, using keyword categories and a plain headline list instead of the written brief.
GROQ_API_KEY=

# Optional: pick a different Groq model (default: llama-3.3-70b-versatile).
GROQ_MODEL=

# Any long random string. Vercel Cron sends it so only Vercel can trigger /api/refresh.
CRON_SECRET=

# Optional: a different YouTube channel to follow.
SIT_YOUTUBE_CHANNEL_ID=

# Optional: the public URL once deployed, used for links in sitemap and share cards.
NEXT_PUBLIC_SITE_URL=
